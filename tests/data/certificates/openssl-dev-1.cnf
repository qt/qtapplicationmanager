HOME            = .
RANDFILE        = $ENV::HOME/.rnd

####################################################################
[ req ]
prompt              = no
distinguished_name  = dev1_distinguished_name
req_extensions      = dev1_req_extensions
string_mask         = utf8only

####################################################################
[ dev1_distinguished_name ]
C = DE
O = Developer 1 GmbH
CN = Developer 1
emailAddress = dev1@developer1.com

####################################################################
[ dev1_req_extensions ]

subjectKeyIdentifier= hash
basicConstraints    = CA:FALSE
keyUsage            = nonRepudiation, digitalSignature, keyEncipherment, decipherOnly
subjectAltName      = @dev1_package_restrictions

####################################################################
[ dev1_package_restrictions ]
URI.1 = "qtam://packageid/other-*"
URI.2 = "qtam://packageid/test-pkg"
URI.3 = "qtam://applicationid/*"
URI.4 = "qtam://category/*"
URI.5 = "qtam://capability/*"
URI.6 = "qtam://runtime/*"
URI.7 = "qtam://version/6.12"
