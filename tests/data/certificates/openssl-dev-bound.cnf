HOME            = .
RANDFILE        = $ENV::HOME/.rnd

####################################################################
[ req ]
prompt              = no
distinguished_name  = dev_bound_distinguished_name
req_extensions      = dev_bound_req_extensions
string_mask         = utf8only

####################################################################
[ dev_bound_distinguished_name ]
C = DE
O = Bound Developer
CN = Bound Developer
emailAddress = bound@developer.com

####################################################################
[ dev_bound_req_extensions ]

subjectKeyIdentifier= hash
basicConstraints    = CA:FALSE
keyUsage            = nonRepudiation, digitalSignature, keyEncipherment, decipherOnly
subjectAltName      = @dev_bound_restrictions

####################################################################
# Same restrictions as dev-narrow, but bound to two hardware ids: "foobar" and the
# percent-encoded "Bar/42 #?[x]%".
[ dev_bound_restrictions ]
URI.1 = "qtam://packageid/test-pkg"
URI.2 = "qtam://applicationid/test-app"
URI.3 = "qtam://capability/cap-allowed"
URI.4 = "qtam://category/test-category"
URI.5 = "qtam://runtime/qml"
URI.6 = "qtam://hardwareid/foobar"
URI.7 = "qtam://hardwareid/Bar%2F42%20%23%3F%5Bx%5D%25"
URI.8 = "qtam://version/6.12.1"
