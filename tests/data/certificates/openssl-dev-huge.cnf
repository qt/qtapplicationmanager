HOME            = .
RANDFILE        = $ENV::HOME/.rnd

####################################################################
[ req ]
prompt              = no
distinguished_name  = dev_huge_distinguished_name
req_extensions      = dev_huge_req_extensions
string_mask         = utf8only

####################################################################
[ dev_huge_distinguished_name ]
C = DE
O = Huge Developer GmbH
CN = Huge Developer
emailAddress = huge@developer.com

####################################################################
[ dev_huge_req_extensions ]

subjectKeyIdentifier= hash
basicConstraints    = CA:FALSE
keyUsage            = nonRepudiation, digitalSignature, keyEncipherment, decipherOnly
subjectAltName      = @dev_huge_restrictions

####################################################################
[ dev_huge_restrictions ]
