HOME            = .
RANDFILE        = $ENV::HOME/.rnd

####################################################################
[ req ]
prompt              = no
distinguished_name  = dev_multiversion_distinguished_name
req_extensions      = dev_multiversion_req_extensions
string_mask         = utf8only

####################################################################
[ dev_multiversion_distinguished_name ]
C = DE
O = Multiversion Developer
CN = Multiversion Developer
emailAddress = multiversion@developer.com

####################################################################
[ dev_multiversion_req_extensions ]

subjectKeyIdentifier= hash
basicConstraints    = CA:FALSE
keyUsage            = nonRepudiation, digitalSignature, keyEncipherment, decipherOnly
subjectAltName      = @dev_multiversion_restrictions

####################################################################
# This deliberately carries two version SANs, which is malformed: such a certificate must be
# rejected during verification, never silently downgraded to one of the two versions.
[ dev_multiversion_restrictions ]
URI.1 = "qtam://packageid/test-pkg"
URI.2 = "qtam://applicationid/*"
URI.3 = "qtam://category/*"
URI.4 = "qtam://capability/*"
URI.5 = "qtam://version/6.12"
URI.6 = "qtam://version/6.11"
