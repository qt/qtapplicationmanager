HOME            = .
RANDFILE        = $ENV::HOME/.rnd

####################################################################
[ req ]
prompt              = no
distinguished_name  = dev_narrow_distinguished_name
req_extensions      = dev_narrow_req_extensions
string_mask         = utf8only

####################################################################
[ dev_narrow_distinguished_name ]
C = DE
O = Narrow Developer GmbH
CN = Narrow Developer
emailAddress = narrow@developer.com

####################################################################
[ dev_narrow_req_extensions ]

subjectKeyIdentifier= hash
basicConstraints    = CA:FALSE
keyUsage            = nonRepudiation, digitalSignature, keyEncipherment, decipherOnly
subjectAltName      = @dev_narrow_restrictions

####################################################################
[ dev_narrow_restrictions ]
URI.1 = "qtam://packageid/test-pkg"
URI.2 = "qtam://applicationid/test-app"
URI.3 = "qtam://capability/cap-allowed"
URI.4 = "qtam://category/test-category"
URI.5 = "qtam://version/6.12"
