HOME            = .
RANDFILE        = $ENV::HOME/.rnd

####################################################################
[ req ]
prompt              = no
distinguished_name  = dev_revoked_distinguished_name
req_extensions      = dev_revoked_req_extensions
string_mask         = utf8only

####################################################################
[ dev_revoked_distinguished_name ]
C = DE
O = Revoked Developer
CN = Revoked Developer
emailAddress = revoked@developer.com

####################################################################
[ dev_revoked_req_extensions ]

subjectKeyIdentifier= hash
basicConstraints    = CA:FALSE
keyUsage            = nonRepudiation, digitalSignature, keyEncipherment
subjectAltName      = @dev_revoked_package_restrictions

####################################################################
[ dev_revoked_package_restrictions ]
URI.1 = "qtam://packageid/other-*"
URI.2 = "qtam://packageid/test-pkg"
URI.3 = "qtam://applicationid/*"
URI.4 = "qtam://category/*"
URI.5 = "qtam://capability/*"
URI.6 = "qtam://runtime/*"
URI.7 = "qtam://version/6.12"
