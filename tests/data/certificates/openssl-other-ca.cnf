HOME            = .
RANDFILE        = $ENV::HOME/.rnd

####################################################################
[ ca ]
default_ca  = CA_default        # The default ca section

[ CA_default ]

default_days    = 3650          # how long to certify for
default_crl_days= 30            # how long before next CRL
default_md      = sha256        # use public key default MD
preserve        = no            # keep passed DN ordering

x509_extensions = ca_extensions # The extensions to add to the cert

email_in_dn = no                # Don't concat the email in the DN
copy_extensions = copy          # Required to copy SANs from CSR to cert

base_dir    = ./other-ca
certificate = $base_dir/other-ca.crt      # The CA certifcate
private_key = $base_dir/other-ca-priv.key # The CA private key
new_certs_dir = $base_dir/new-certs       # Location for new certs after signing
database    = $base_dir/index.txt         # Database index file
serial      = $base_dir/serial.txt        # The current serial number
crlnumber   = $base_dir/crlnumber.txt
crl         = $base_dir/other-ca.crl

unique_subject  = no                # allow re-signing leaves with the same subject
                                    # when the script is re-run against a preserved CA

####################################################################
[ req ]
prompt              = no
distinguished_name  = other_distinguished_name
x509_extensions     = other_extensions
string_mask         = utf8only

####################################################################
[ other_distinguished_name ]
C = DE
O = Other Company
OU = Other
CN = Other Company CA
emailAddress = info@other-company.de

####################################################################
[ other_extensions ]

subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid:always, issuer
basicConstraints = critical, CA:true
keyUsage = keyCertSign, cRLSign


####################################################################
[ signing_policy ]
countryName             = optional
stateOrProvinceName     = optional
localityName            = optional
organizationName        = optional
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

####################################################################
[ signing_req ]
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid,issuer

basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment, decipherOnly
