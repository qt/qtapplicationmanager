HOME            = .
RANDFILE        = $ENV::HOME/.rnd

####################################################################
[ req ]
prompt              = no
distinguished_name  = other_distinguished_name
req_extensions      = other_req_extensions
string_mask         = utf8only

####################################################################
[ other_distinguished_name ]
C = DE
ST = Foo
L = Bar
CN = www.other.com

####################################################################
[ other_req_extensions ]

subjectKeyIdentifier= hash
basicConstraints    = CA:FALSE
keyUsage            = nonRepudiation, digitalSignature, keyEncipherment, decipherOnly
subjectAltName      = @other_package_restrictions

####################################################################
[ other_package_restrictions ]
URI.1 = "qtam://packageid/*"
URI.2 = "qtam://applicationid/*"
URI.3 = "qtam://category/*"
URI.4 = "qtam://capability/*"
URI.5 = "qtam://runtime/*"
URI.6 = "qtam://version/6.12"
