HOME            = .
RANDFILE        = $ENV::HOME/.rnd

####################################################################
[ req ]
prompt              = no
distinguished_name  = store_611_distinguished_name
req_extensions      = store_611_req_extensions
string_mask         = utf8only

####################################################################
[ store_611_distinguished_name ]
C = DE
O = Pelagicore AG
OU = App Store
CN = Pelagicore App Store 6.11
emailAddress = info@pelagicore.com

####################################################################
# A 6.11 app-store certificate: correct key-usage, but no version SAN.
[ store_611_req_extensions ]

subjectKeyIdentifier= hash
basicConstraints    = CA:FALSE
keyUsage            = nonRepudiation, digitalSignature, keyEncipherment, encipherOnly
