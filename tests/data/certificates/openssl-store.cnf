HOME            = .
RANDFILE        = $ENV::HOME/.rnd

####################################################################
[ req ]
prompt              = no
distinguished_name  = store_distinguished_name
req_extensions      = store_req_extensions
string_mask         = utf8only

####################################################################
[ store_distinguished_name ]
C = DE
O = Pelagicore AG
OU = App Store
CN = Pelagicore App Store
emailAddress = info@pelagicore.com

####################################################################
[ store_req_extensions ]

subjectKeyIdentifier= hash
basicConstraints    = CA:FALSE
keyUsage            = nonRepudiation, digitalSignature, keyEncipherment, encipherOnly
subjectAltName      = @store_restrictions

####################################################################
[ store_restrictions ]
URI.1 = "qtam://version/6.12"
